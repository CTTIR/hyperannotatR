function (file, filter.metadata = FALSE, proprietary.metadata = TRUE) 
{
    reader = .getReader()
    on.exit(.close(reader))
    .setupReader(file, filter.metadata, proprietary.metadata, 
        omexml = FALSE)
    metadata = .getMetadataList(reader)
    if (length(metadata) == 1L) 
        metadata[[1L]]
    else metadata
}
