{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "annotatr-control-v1/event.schema.json",
  "title": "annotatr-control-v1 event",
  "type": "object",
  "required": ["event_id", "seq", "type", "session_id", "state_revision", "time", "origin", "payload"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^instance-[0-9a-f-]{36}:[0-9]+$"},
    "seq": {"type": "integer", "minimum": 1},
    "type": {"type": "string", "enum": ["service.started", "session.loaded", "session.saved", "image.changed",
      "view.changed", "selection.changed", "annotations.staged", "annotations.committed",
      "annotations.edited", "queue.status_changed", "mask.previewed", "export.completed", "training.exported",
      "app.connected", "app.disconnected", "connection.closing"]},
    "session_id": {"type": "string"},
    "state_revision": {"type": "string", "pattern": "^[0-9]+$"},
    "time": {"type": "string"},
    "origin": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"type": "string", "enum": ["control", "app"]}, "request_id": {"type": "string"}}
    },
    "payload": {"type": "object"}
  }
}
