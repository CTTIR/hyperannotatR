{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "annotatr-handoff-v1/manifest.schema.json",
  "title": "hyperannotatR partner manifest",
  "description": "Sanitised description of hyperannotatR objects for a partner package. No absolute paths. Unknown optional data belongs under 'extensions'.",
  "type": "object",
  "required": ["schema", "schema_version", "document", "consumer", "object_kind", "annotatr_version",
               "r_version", "capability_digest", "created", "coordinate_convention", "images", "layers",
               "annotations", "masks", "projects", "provenance", "extensions"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "annotatr-handoff-v1"},
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "document": {"const": "manifest"},
    "consumer": {"type": "string"},
    "object_kind": {"type": "string", "enum": ["project", "session", "image", "layer", "roi", "mask", "training"]},
    "annotatr_version": {"type": "string"},
    "r_version": {"type": "string"},
    "source_revision": {"type": ["string", "null"]},
    "capability_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "coordinate_convention": {"$ref": "#/definitions/coordinate_convention"},
    "images": {"type": "array", "items": {"$ref": "#/definitions/image"}},
    "layers": {"type": "array", "items": {"$ref": "#/definitions/layer"}},
    "annotations": {
      "type": "object",
      "required": ["count", "annotation_revision", "rois"],
      "additionalProperties": false,
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "annotation_revision": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "rois": {"type": "array", "items": {"$ref": "#/definitions/roi"}}
      }
    },
    "masks": {"type": "array", "items": {"$ref": "#/definitions/mask"}},
    "projects": {"type": "array", "items": {"type": "object"}},
    "session": {"type": ["object", "null"]},
    "files": {"type": "array", "items": {"type": "object"}},
    "hsi_manifest": {"type": ["string", "null"]},
    "provenance": {"type": "object"},
    "extensions": {"type": "object"}
  },
  "definitions": {
    "coordinate_convention": {
      "type": "object",
      "required": ["origin", "x_axis", "y_axis", "units", "level_scale", "pixel_centre", "plane_indexing"],
      "properties": {
        "origin": {"const": "top_left"},
        "x_axis": {"const": "right"},
        "y_axis": {"const": "down"},
        "units": {"const": "px"},
        "level_scale": {"type": "string"},
        "pixel_centre": {"type": "string"},
        "plane_indexing": {"const": "zero_based"}
      }
    },
    "plane": {
      "type": "object",
      "required": ["c", "z", "t"],
      "properties": {
        "c": {"type": ["integer", "null"], "minimum": 0},
        "z": {"type": "integer", "minimum": 0},
        "t": {"type": "integer", "minimum": 0}
      }
    },
    "image": {
      "type": "object",
      "required": ["image_id", "role", "source_name", "source_files", "backend", "width", "height",
                   "n_levels", "level_dims", "n_bands", "dtype", "plane", "bands", "hsi", "transform_digest"],
      "properties": {
        "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{16}$"},
        "role": {"type": "string"},
        "source_name": {"type": "string", "pattern": "^[^/\\\\]+$"},
        "source_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "name", "size_bytes", "sha256", "hash_status"],
            "properties": {
              "role": {"type": "string"},
              "name": {"type": "string", "pattern": "^[^/\\\\]+$"},
              "size_bytes": {"type": ["integer", "null"], "minimum": 0},
              "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "hash_status": {"type": "string", "enum": ["ok", "missing", "skipped"]}
            }
          }
        },
        "backend": {"type": "string"},
        "image_kind": {"type": "string", "enum": ["spectral", "multichannel", "rgb", "grayscale"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "n_levels": {"type": "integer", "minimum": 1},
        "level_dims": {"type": "array", "minItems": 1},
        "n_bands": {"type": "integer", "minimum": 1},
        "dtype": {"type": "string"},
        "plane": {"$ref": "#/definitions/plane"},
        "bands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "name", "wavelength", "fwhm", "unit", "wavelength_status"],
            "properties": {
              "index": {"type": "integer", "minimum": 1},
              "name": {"type": "string"},
              "wavelength": {"type": ["number", "null"]},
              "fwhm": {"type": ["number", "null"]},
              "unit": {"type": ["string", "null"]},
              "wavelength_status": {"type": "string", "enum": ["ok", "missing", "duplicate", "non_numeric"]}
            }
          }
        },
        "hsi": {
          "type": "object",
          "required": ["value_unit", "calibration_status"],
          "properties": {
            "value_unit": {"type": "string", "enum": ["raw", "reflectance", "radiance", "intensity", "absorbance", "unknown"]},
            "calibration_status": {"type": "string"}
          }
        },
        "calibration_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "transform_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "layer": {
      "type": "object",
      "required": ["name", "labels", "z", "visible", "locked"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "labels": {"type": "array", "items": {"type": "string"}},
        "colours": {"type": "object"},
        "z": {"type": "integer"},
        "visible": {"type": "boolean"},
        "locked": {"type": "boolean"}
      }
    },
    "roi": {
      "type": "object",
      "required": ["roi_id", "layer", "label", "level", "geom_type", "geometry_sha256", "source", "locked",
                   "review_status", "geometry_fidelity", "native_roi", "hierarchy", "plane"],
      "properties": {
        "roi_id": {"type": "string", "minLength": 1},
        "image_id": {"type": ["string", "null"]},
        "layer": {"type": "string"},
        "label": {"type": "string"},
        "level": {"type": "integer", "minimum": 0},
        "geom_type": {"type": "string", "enum": ["POINT", "MULTIPOINT", "LINESTRING", "MULTILINESTRING", "POLYGON", "MULTIPOLYGON", "GEOMETRYCOLLECTION"]},
        "geometry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source": {"type": "string"},
        "locked": {"type": "boolean"},
        "review_status": {"type": "string", "enum": ["unreviewed", "reviewed", "rejected", "staged"]},
        "geometry_fidelity": {"type": "string", "enum": ["exact", "approximated"]},
        "native_roi": {"type": "string", "enum": ["unknown", "approximated"]},
        "hierarchy": {"const": "unknown"},
        "plane": {"$ref": "#/definitions/plane"}
      }
    },
    "mask": {
      "type": "object",
      "required": ["mask_type", "dtype", "background", "width", "height", "level", "legend", "legend_sha256"],
      "properties": {
        "mask_id": {"type": ["string", "null"]},
        "file": {"type": ["string", "null"]},
        "mask_type": {"type": "string", "enum": ["binary", "labelled", "multiclass", "instance"]},
        "dtype": {"type": "string", "enum": ["bool", "uint8", "uint16", "int16", "int32"]},
        "background": {"type": "integer"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "level": {"type": "integer", "minimum": 0},
        "legend": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": {
              "value": {"type": "integer"},
              "label": {"type": "string"},
              "layer": {"type": ["string", "null"]},
              "roi_id": {"type": ["string", "null"]},
              "n_px": {"type": ["integer", "null"], "minimum": 0},
              "colour": {"type": ["string", "null"]}
            }
          }
        },
        "legend_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
